# Tradier SANDBOX (paper) credentials — https://developer.tradier.com
# (create a developer account -> sandbox access token + sandbox account id)
TRADIER_TOKEN=your_sandbox_access_token_here
TRADIER_ACCOUNT_ID=your_sandbox_account_id_here

# OPTIONAL shared secret: if set, every alert must carry a matching "token"
# field. If left empty the check is skipped — your PRIMARY safety measure is
# keeping the webhook URL secret (never share or screenshot it).
WEBHOOK_TOKEN=pick_a_long_random_string
