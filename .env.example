# Every setting this app reads is listed here. Copy this file to .env and fill
# in the real values. NEVER commit .env - it is in .gitignore for that reason.
#
# On a cloud host there is no .env file: set these same names in the host's
# environment-variable settings instead.

# --- Tradier SANDBOX (paper) credentials -------------------------------------
# https://developer.tradier.com
# (create a developer account -> sandbox access token + sandbox account id)
# Read by the broker module. PAPER ONLY - never put live-account values here.
TRADIER_TOKEN=your_sandbox_access_token_here
TRADIER_ACCOUNT_ID=your_sandbox_account_id_here

# How long to wait on Tradier before giving up, in seconds. Keep it short:
# TradingView abandons a webhook after only a few seconds, so this app has to
# give up first and log the reason. Default: 4
BROKER_TIMEOUT_SECONDS=4

# --- Webhook shared secret ---------------------------------------------------
# OPTIONAL: if set, every alert must carry a matching "token" field. If left
# empty the check is skipped — your PRIMARY safety measure is keeping the
# webhook URL secret (never share or screenshot it).
# Whatever you put here must also go in the Pine strategy's "Webhook token" input.
WEBHOOK_TOKEN=pick_a_long_random_string

# --- Audit trail -------------------------------------------------------------
# The file every alert is written to. This project has no database; this file
# IS the record. Default: webhook.log
WEBHOOK_LOG_FILE=webhook.log

# --- Alert validation --------------------------------------------------------
# Comma-separated list of instructions the receiver will accept.
# Default: buy,sell
ALLOWED_ACTIONS=buy,sell

# How long (in seconds) to ignore an identical repeat of an alert just handled,
# so a TradingView retry cannot become a second real order. 0 disables it.
# Default: 5
DUPLICATE_WINDOW_SECONDS=5

# --- Local development only --------------------------------------------------
# Port the development server listens on. A cloud host sets this itself.
# Default: 5000
PORT=5000
